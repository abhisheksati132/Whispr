{
  "name": "whispr",
  "version": "2.0.0",
  "description": "Minimal private chat for exactly two people with a technical terminal HUD UI",
  "main": "server/index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node server/index.js",
    "lint": "eslint server/**/*.js public/js/*.js test/*.test.js",
    "db:setup": "node -e \"const fs=require('fs'); const sql=fs.readFileSync('supabase_schema.sql','utf8'); console.log('Run this SQL in Supabase Dashboard -> SQL Editor:\\n\\n' + sql)\""
  },
  "keywords": [
    "chat",
    "terminal-hud",
    "webrtc",
    "private-chat"
  ],
  "author": "Whispr Contributors",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "@supabase/supabase-js": "^2.112.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.5.0",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.16.0",
    "socket.io-client": "^4.8.4"
  }
}
