# Server Port & Environment
PORT=3000
NODE_ENV=development

# JWT Secret (minimum 32 characters required in production)
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters

# Supabase (PostgreSQL & Storage)
# Required for production persistence. Connects strictly using the Service Role Key (RLS enabled).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Web Push (VAPID)
# Required in production for notifications on mobile / closed browser.
# Generate via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=https://your-domain.com

# WebRTC STUN / TURN Credentials
# STUN is public, but TURN is required for mobile cellular & symmetric NAT traversal.
# Example: coturn server or hosted service like Metered / Twilio / Xirsys.
TURN_URL=turn:turn.your-domain.com:3478
TURN_USERNAME=your-turn-username
TURN_CREDENTIAL=your-turn-password

# CORS / Origin Configuration
ALLOWED_ORIGINS=https://your-domain.com

# Optional Sentry Error Tracking
# SENTRY_DSN=https://your-sentry-dsn
